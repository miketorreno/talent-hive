# Copy to .env and fill in your values.
TH_TELEGRAM_TOKEN=
TH_REDIS_URL=redis://localhost:6379/0

# AI providers (v1: Groq and Google AI Studio). Leave empty to disable a
# provider; "auto" below picks the first provider with a key set.
TH_GROQ_API_KEY=
TH_GOOGLE_AI_API_KEY=

# Provider selection per artifact type: "groq" | "google" | "auto".
TH_COVER_LETTER_PROVIDER=auto
TH_RESUME_PROVIDER=auto
TH_JOB_DESCRIPTION_PROVIDER=auto
